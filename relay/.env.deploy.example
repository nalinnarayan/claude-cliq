# Copy to .env.deploy (untracked) and fill in. Never commit the real file.
CLIQ_BOT_NAME=
CLIQ_ZAPIKEY=
CLIQ_BASE_URL=https://cliq.zoho.com
RELAY_INBOUND_SECRET=
DEBUG_USERS=
POLL_TICK_MS=3000

# Catalyst Data Streams channel the relay rings for a wake. Console ->
# Cloud Scale -> Data Streams -> the channel's Dashboard tab. The ID, not
# the name: every SDK call takes the ID.
DS_CHANNEL_ID=

# Datacenter suffix for the relay URL that render.py bakes into the Deluge
# handlers -- `in` or `com`. Nothing in .catalystrc names the DC, so it has
# to be stated. Do NOT call this CATALYST_TLD: Catalyst rejects a deploy
# whose env contains reserved keywords, and CATALYST_* is reserved.
RELAY_TLD=in

# Derives the opaque per-account wake label the doorbell rings. Relay-only --
# no client ever receives it. Any long random string; changing it simply
# changes every label, which costs one missed bell per account.
RELAY_STREAM_SECRET=

# Stratus bucket for forwarded Cliq attachments (create it in the console;
# there is no CLI for buckets). Leave empty to disable image forwarding.
STRATUS_BUCKET=

# The onboarding walkthrough, DM'd the moment someone subscribes. The key of
# an object in STRATUS_BUCKET -- upload it in the console, since there is no
# CLI for Stratus objects. Leave EMPTY to send no video; the key must still be
# present, because deploy.sh checks for the key, not the value, and a missing
# line would unset it silently.
#
# It is sent BEFORE the welcome text, and cannot be otherwise: the text is the
# Deluge handler's return value, so it only goes out once /issue-code answers.
# The caption is what frames it, so write it knowing the steps come next.
WELCOME_VIDEO_KEY=
WELCOME_VIDEO_CAPTION=
