// Bot welcome handler -- fires when someone subscribes to the Claude Code bot.
// Deluge bots declare no permissions: `user` is passed in automatically.
// Cliq shows each user a consent dialog on first execution, based on what
// the code actually touches, and that consent lapses after 60 days.

response = Map();

payload = Map();
payload.put("cliq_user", user.get("id"));
payload.put("email", user.get("email"));

headers = Map();
headers.put("Content-Type", "application/json");
headers.put("X-Relay-Secret", "REPLACE_WITH_RELAY_INBOUND_SECRET");

result = invokeurl
[
	url: "REPLACE_WITH_RELAY_BASE/issue-code"
	type: POST
	parameters: payload.toString()
	headers: headers
];

code = result.get("code");

// The escape hatch from a ten-minute code. It rides on BOTH responses below:
// on the failure path it is a retry, and on the success path it is what
// someone reaches for an hour later when the code in this very message has
// run out. Before it existed, their only route was to unsubscribe and
// subscribe again, which nobody guesses.
//
// `owner` is not optional. It may be omitted only for whoever created the
// function; for everyone else Cliq will not invoke it. Every colleague who
// subscribes is everyone else.
newCodeData = Map();
newCodeData.put("name", "REPLACE_WITH_NEWCODE_FUNCTION_NAME");
newCodeData.put("owner", "REPLACE_WITH_FUNCTION_OWNER");

newCodeAction = Map();
newCodeAction.put("type", "invoke.function");
newCodeAction.put("data", newCodeData);

newCodeButton = Map();
// TWENTY characters is the measured cap -- beyond it Cliq rejects the whole
// message with input_maxlength_reached. This is eighteen.
newCodeButton.put("label", "Send me a new code");
// Documented as REQUIRED on a button: "+" renders green, "-" red. The relay's
// API-sent buttons omit it and render anyway, so it is only enforced on this
// path -- which is why the first attempt here produced no button at all.
newCodeButton.put("type", "+");
newCodeButton.put("action", newCodeAction);

buttons = List();
buttons.add(newCodeButton);

if(code == null)
{
	response.put("text", "I couldn't generate a pairing code just now. Tap below to try again.");
	response.put("buttons", buttons);
	return response;
}

msg = "👋 You're subscribed.\n\n";
// What the bot is for, before how to set it up. A subscriber arriving
// from the bot directory has no other description to go on, and two
// paste-this steps with no statement of purpose read as setup for
// something they have not been told about.
msg = msg + "This bot helps you control your Claude from Zoho Cliq. You can converse with Claude, answer its questions, review plans, and grant permissions.\n\n";
msg = msg + "Only one caveat: your laptop should be on and Claude should be running — in your terminal, the desktop app, or inside your IDE.\n\n";
msg = msg + "*1. Claude Code on Terminal*\n\n";
// One command, not two: `--marketplace` adds a source that is not registered
// yet, "under the same checks as 'plugin marketplace add'". The trust prompt
// is the same; it is the second paste that is gone.
//
// Pairing stays separate because it is a slash command INSIDE a session,
// not a shell command. It could call cliqctl.py directly, but only via a
// version-pinned path under ~/.claude/plugins/cache, which would break on the
// next release -- and by then they have the plugin, so the slash command is
// the better introduction to it anyway.
msg = msg + "In your terminal:\n";
msg = msg + "```\nclaude plugin install cliq-claude-is-waiting --marketplace REPLACE_WITH_REPO\n```\n";
msg = msg + "Then, inside Claude Code:\n";
// The relay URL rides along because nothing on the user's machine knows
// it yet: the plugin ships no default (every deployment has its own
// relay, so a shipped one would point this pairing at someone else's
// account). Rendered per environment, like every other value here.
msg = msg + "```\n/cliq-waiting:pair " + code + " REPLACE_WITH_RELAY_BASE\n```\n\n";
// The desktop app has no terminal to paste into and its /plugin panel does
// not run there, so the route is Settings -> Plugins -> Add marketplace. That
// is a sequence of clicks, which a video shows far better than prose -- and
// the video follows rather than precedes, so this line has to promise it.
msg = msg + "*2. Claude Mac Desktop App*\n\n";
msg = msg + "See the short video in the next message.\n\n";
msg = msg + "The code is good for 10 minutes — if it runs out, tap *Send me a new code* below. Once paired, run `/cliq-waiting:away on` whenever you step away and I'll ping you here.";

response.put("text", msg);
response.put("buttons", buttons);
return response;
