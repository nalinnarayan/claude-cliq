// Bot FUNCTION (not a handler) -- the target of every button's
// action.type = invoke.function.
//
// The button carries `arguments`, which is where the request id rides. That
// is the whole point: a tap is bound by construction, so it can never reach
// the wrong session and nothing has to be typed.
//
// Create this in the bot builder as a function named exactly (Cliq
// function names allow letters only -- no underscores):
//     REPLACE_WITH_FUNCTION_NAME
//
// The name is per ENVIRONMENT, not per bot. Cliq functions are account-level,
// so every bot in the account sees the same list -- which means a test bot
// reusing the production function would post button taps to the production
// relay, with the production secret. Hence CLIQ_FUNCTION_NAME.

payload = Map();
payload.put("cliq_user", user.get("id"));
payload.put("req", arguments.get("req"));
payload.put("ans", arguments.get("ans"));

headers = Map();
headers.put("Content-Type", "application/json");
headers.put("X-Relay-Secret", "REPLACE_WITH_RELAY_INBOUND_SECRET");

// One return at the top level: Deluge does not count a return inside a try.
response = Map();
try
{
	invokeurl
	[
		url: "REPLACE_WITH_RELAY_BASE/cliq-action"
		type: POST
		parameters: payload.toString()
		headers: headers
	];
	response.put("text", "✓ " + arguments.get("ans"));
}
catch (e)
{
	response.put("text", "Couldn't reach Claude Code: " + e.toString());
}
return response;
