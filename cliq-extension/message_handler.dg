// Bot message handler -- fires on every reply the user types to the bot.
//
// Everything useful is in `message_details`, NOT the bare `message`
// variable, which is empty for an attachment and carries no reply context:
//
//   message_details.message.text              typed text
//   message_details.message.comment           caption, when a file is attached
//   message_details.message.replied_message   the message a swipe-reply answers
//   message_details.message.id                this message's own id, if present
//
// `replied_message.text` is what binds a reply to its request: outbound
// messages carry "(id xxxxx)", so the id comes back and no one types it.
//
// Deluge wants ONE return at the top level -- a return inside a try does not
// count, and the compiler reports it against the `try` line, which is
// thoroughly misleading. Hence the single `return response` at the end.
//
// Avoided on purpose: `left()` and `trim()` on these values, which error at
// runtime. Everything is forced through toString() instead.

response = Map();
try
{
	md = message_details.get("message");
	mtype = md.get("type");

	body = "";
	if(mtype == "attachment")
	{
		body = md.get("comment");
	}
	else
	{
		body = md.get("text");
	}
	if(body == null)
	{
		body = "";
	}
	body = body.toString();

	// The relay files each reply under this so a handler that fires twice
	// collides instead of delivering the same reply twice. Measured, by
	// trying each in turn and tagging the winner:
	//
	//   message_details.message.id    null
	//   message_details.id            null
	//   message_details.message_id    null
	//   message_details.message.time  null
	//   message_details.time          WORKS -- epoch milliseconds
	//
	// So a handler gets no message id at all, even though a BUTTON function's
	// `message` object carries one. A timestamp does the job regardless: the
	// point is only that the same message filed twice collides, and one person
	// cannot send two messages in the same millisecond. The id fields are
	// still tried first, in case a later Cliq provides one.
	//
	// The tag is kept deliberately -- the key says where it came from, so if
	// Cliq ever changes this, the next person reads it off a row instead of
	// rediscovering it.
	msgId = "";
	mid = md.get("id");
	tag = "id";
	if(mid == null)
	{
		mid = message_details.get("id");
		tag = "mdid";
	}
	if(mid == null)
	{
		mid = message_details.get("message_id");
		tag = "mdmid";
	}
	if(mid == null)
	{
		mid = md.get("time");
		tag = "time";
	}
	// Candidates the first probe never tried. The documented message object
	// (cliq-objects/message-object.html) lists BOTH `id` and `ack_key`, and
	// nests the body under `content` -- so if a handler is handed anything of
	// that shape, an id may be sitting one level down. Worth knowing even
	// though no post-message endpoint accepts a reply target: a real id is a
	// better idempotency key than a timestamp.
	//
	// These must come BEFORE the mdtime fallback. Put after it they would
	// never run at all, because mdtime always succeeds -- the first attempt
	// at this probe made exactly that mistake and would have reported
	// nothing. Ordering them first costs nothing: the tag says which answered,
	// and mdtime still catches everything below.
	if(mid == null)
	{
		mid = md.get("ack_key");
		tag = "ack";
	}
	if(mid == null)
	{
		cont = md.get("content");
		if(cont != null)
		{
			mid = cont.get("id");
			tag = "contentid";
		}
	}
	if(mid == null)
	{
		mid = message_details.get("ack_key");
		tag = "mdack";
	}
	if(mid == null)
	{
		mid = message_details.get("time");
		tag = "mdtime";
	}
	if(mid != null)
	{
		msgId = tag + "-" + user.get("id") + "-" + mid.toString();
	}

	// An attachment's bytes, forwarded before the text that announces them.
	//
	// Order matters: the inbound POST below rings the doorbell, and the laptop
	// starts fetching the file within a second of hearing it. Uploading second
	// would race that fetch and lose.
	//
	// `file.url` is NOT usable -- it carries ?type=transient and returns
	// attachment_access_time_expired within minutes, and the laptop holds no
	// Cliq credential anyway. `attachments` is the Deluge file object, and
	// `invokeurl ... files:` is the only durable way to move it.
	fileName = "";
	if(mtype == "attachment")
	{
		try
		{
			fname = "the file";
			finfo = md.get("file");
			if(finfo != null)
			{
				fn = finfo.get("name");
				if(fn != null)
				{
					fileName = fn.toString();
					fname = fileName;
				}
			}
			// A list in some shapes, the file object itself in others; asking
			// for element 0 and falling back costs nothing and avoids caring.
			fobj = attachments;
			try
			{
				fobj = attachments.get(0);
			}
			catch (le)
			{
				fobj = attachments;
			}
			up = invokeurl
			[
				url: "REPLACE_WITH_RELAY_BASE/cliq-file?u=" + user.get("id") + "&mid=" + msgId
				type: POST
				files: fobj
				headers: {"X-Relay-Secret": "REPLACE_WITH_RELAY_INBOUND_SECRET"}
			];
			// The upload must be CONFIRMED, not assumed. invokeurl does not
			// raise on an HTTP error, so a rejected upload -- a video over the
			// 10 MB ceiling, say -- looked exactly like a successful one: the
			// file name was sent, the relay appended its marker, and the
			// laptop was left to 404 on an object that had never been stored.
			// The relay answers {"ok":true,...} on success and {"error":...}
			// otherwise, so the body is the thing to check.
			ok = false;
			why = "";
			try
			{
				ok = up.get("ok");
				if (ok != true)
				{
					why = up.get("error").toString();
				}
			}
			catch (pe)
			{
				// Not even a map -- an HTML error page, or a gateway reply.
				ok = false;
			}
			if (ok != true)
			{
				if (why == "")
				{
					why = "the relay would not take it";
				}
				fileName = "";
				body = body + " (" + fname + " came with this but could not be forwarded: " + why + ")";
			}
		}
		catch (fe)
		{
			// The file is lost; the message is not. The text still goes, and
			// says why there is nothing to look at.
			fileName = "";
			body = body + " (a file came with this, but it could not be forwarded: " + fe.toString() + ")";
		}
	}

	repliedText = "";
	replied = md.get("replied_message");
	if(replied != null)
	{
		rt = replied.get("text");
		if(rt != null)
		{
			repliedText = rt.toString();
		}
	}

	if(body == "" && repliedText == "" && fileName == "")
	{
		response.put("text", "I couldn't read that one — send it as text, or as a file with a caption.");
	}
	else
	{
		payload = Map();
		payload.put("cliq_user", user.get("id"));
		payload.put("text", body);
		payload.put("replied_text", repliedText);
		payload.put("message_id", msgId);
		// The relay appends the "[attached: ...]" marker itself from this, so
		// a caption containing one cannot forge it.
		payload.put("file_name", fileName);

		headers = Map();
		headers.put("Content-Type", "application/json");
		headers.put("X-Relay-Secret", "REPLACE_WITH_RELAY_INBOUND_SECRET");

		invokeurl
		[
			url: "REPLACE_WITH_RELAY_BASE/cliq-inbound"
			type: POST
			parameters: payload.toString()
			headers: headers
		];
		// Deliberately silent on success. The laptop answers in its own
		// time; an immediate "got it" would be noise on every reply.
	}
}
catch (e)
{
	response.put("text", "Couldn't reach Claude Code just now: " + e.toString());
}
return response;
