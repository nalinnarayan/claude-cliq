// Bot message handler -- fires on every reply the user types to the bot.
//
// Everything useful is in `message_details`, NOT the bare `message`
// variable, which is empty for an attachment and carries no reply context:
//
//   message_details.message.text              typed text
//   message_details.message.comment           caption, when a file is attached
//   message_details.message.replied_message   the message a swipe-reply answers
//   message_details.message.id                this message's own id, if present
//
// `replied_message.text` is what binds a reply to its request: outbound
// messages carry "(id xxxxx)", so the id comes back and no one types it.
//
// Deluge wants ONE return at the top level -- a return inside a try does not
// count, and the compiler reports it against the `try` line, which is
// thoroughly misleading. Hence the single `return response` at the end.
//
// Avoided on purpose: `left()` and `trim()` on these values, which error at
// runtime. Everything is forced through toString() instead.

response = Map();
try
{
	md = message_details.get("message");
	mtype = md.get("type");

	body = "";
	if(mtype == "attachment")
	{
		body = md.get("comment");
	}
	else
	{
		body = md.get("text");
	}
	if(body == null)
	{
		body = "";
	}
	body = body.toString();

	// The relay keys inbound rows on this to make a double-fired handler
	// idempotent. It had never been sent, so the relay fell back to a random
	// UUID on every delivery and the idempotency was decorative -- a handler
	// retry would have delivered the same reply twice.
	//
	// Nothing documents where the incoming message's own id lives, so the
	// plausible places are tried in order. An empty string is fine: the relay
	// falls back to a UUID exactly as before, so this can only improve on
	// what was there.
	msgId = "";
	mid = md.get("id");
	if(mid == null)
	{
		mid = message_details.get("id");
	}
	if(mid == null)
	{
		mid = message_details.get("message_id");
	}
	if(mid != null)
	{
		msgId = mid.toString();
	}

	repliedText = "";
	replied = md.get("replied_message");
	if(replied != null)
	{
		rt = replied.get("text");
		if(rt != null)
		{
			repliedText = rt.toString();
		}
	}

	if(body == "" && repliedText == "")
	{
		response.put("text", "I couldn't read that one — send it as text, or as a file with a caption.");
	}
	else
	{
		payload = Map();
		payload.put("cliq_user", user.get("id"));
		payload.put("text", body);
		payload.put("replied_text", repliedText);
		payload.put("message_id", msgId);

		headers = Map();
		headers.put("Content-Type", "application/json");
		headers.put("X-Relay-Secret", "REPLACE_WITH_RELAY_INBOUND_SECRET");

		invokeurl
		[
			url: "REPLACE_WITH_RELAY_BASE/cliq-inbound"
			type: POST
			parameters: payload.toString()
			headers: headers
		];
		// Deliberately silent on success. The laptop answers in its own
		// time; an immediate "got it" would be noise on every reply.
	}
}
catch (e)
{
	response.put("text", "Couldn't reach Claude Code just now: " + e.toString());
}
return response;
